{
	"$schema": "https://raw.githubusercontent.com/untrustedmodders/plugify/refs/heads/main/schemas/plugin.schema.json",
	"version": "${AS_MAPS_VERSION}",
	"name": "as_maps",
	"description": "Maps module of the Pisex admin_system (Metamod plugin as_maps), ported to Plugify on the native s2sdk API and the admin_system plugin API (no pisexcompat). Adds the server-console 'mm_map <map>' command (@admin/maps) and the 'maps' item of the admin menu's 'server' category: the maps of maps.ini shown in an on-screen menu whose rendering follows the player's own '!menu' choice when the optional hudmenu plugin is installed, a five second delayed level change (changelevel for a server map, ds_workshop_changelevel otherwise), the Changing_Map / Changing_Map_Admin chat announcement and an OnAction('map') notification.",
	"author": "Pisex, ported to Plugify",
	"website": "https://github.com/untrustedmodders/plugify",
	"license": "GPL-3.0",
	"entry": "bin/as_maps",
	"platforms": [],
	"language": "cpp",
	"dependencies": [
		{
			"name": "s2sdk",
			"constraints": ">=2.18.2"
		},
		{
			"name": "admin_system",
			"constraints": ">=1.1.0"
		},
		{
			"name": "hudmenu",
			"constraints": ">=1.0.0",
			"optional": true
		}
	],
	"methods": []
}
